<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-permission android:name="android.permission.INTERNET"/>
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
<uses-permission android:name="android.permission.CALL_PHONE"/>
<uses-permission android:name="android.permission.CAMERA"/>
<!-- Lets Geolocator run location updates as a foreground service (with a
     persistent "Sharing your location" notification) while the driver is
     online, so Android is far less likely to suspend the app the moment
     it's backgrounded (e.g. driver switches to an external navigation
     app). Deliberately not requesting ACCESS_BACKGROUND_LOCATION — that's
     only needed for location access outside of an active foreground
     service/activity, which doesn't apply here, and requesting it would
     reintroduce the extra Play Store review scrutiny this app previously
     removed it to avoid (see git history). -->
<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
<!-- The "return to app" floating bubble shown over Google Maps once a ride
     starts. SYSTEM_ALERT_WINDOW is a special permission — Android won't let
     the app request it with a normal runtime dialog; the driver has to be
     sent to a Settings screen to grant "Display over other apps" (see
     FlutterOverlayWindow.requestPermission()) — and Play Console requires an
     explicit declaration of the use case for it on submission. The two
     FOREGROUND_SERVICE* permissions are what let the overlay keep running
     once the app itself is backgrounded (which it will be — that's the
     entire point of a bubble that persists over another app). -->
<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
<uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="Nride driver"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
              android:name="com.google.firebase.messaging.default_notification_channel_id"
              android:value="high_importance_channel" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
    android:name="com.google.android.geo.API_KEY"
       android:value="AIzaSyBNHiJLxFa2qcs079P5TaYrB770_CVMldU"/>
    
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <meta-data
    android:name="com.facebook.sdk.ApplicationId"
    android:value="2107195303185625"/>
    <meta-data android:name="com.facebook.sdk.ClientToken" android:value="f74329131ab047355602b8d24213e293"/>

        <!-- flutter_overlay_window's own service — hosts the bubble's
             separate Flutter engine as a foreground service so Android
             doesn't tear it down the moment this app itself backgrounds
             (immediately, since launching Google Maps backgrounds it). The
             "specialUse" subtype string is required as of Android 14's
             stricter foreground-service-type rules and is what gets
             reviewed against the Play Console declaration for this
             permission. -->
        <service
            android:name="flutter.overlay.window.flutter_overlay_window.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent return-to-app bubble shown while the driver is navigating in Google Maps during an active ride"/>
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
    <queries>
    <intent>
        <action android:name="android.intent.action.VIEW"/>
        <data android:scheme="https"/>
    </intent>
</queries>
    <!-- Without this, url_launcher's canLaunchUrl()/launchUrl() for a
         "google.navigation:" URI can silently fail on Android 11+ — package
         visibility is restricted by default, and an app has to explicitly
         declare which intent schemes it needs to resolve against installed
         apps rather than seeing the whole device's app list. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="google.navigation"/>
        </intent>
    </queries>
</manifest>
